# Admin service
ADMIN_DATABASE_URL=postgresql://admin:password@postgres:5432/reports
SESSION_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_LISTEN_ADDRESS=0.0.0.0:3000

# Add after the admin UI generated it. The public API also receives this value.
REPORTING_DATABASE_URL=

# Public API service
POW_HMAC_KEY=
CLIENT_ADDRESS_HMAC_KEY=
PUBLIC_LISTEN_ADDRESS=0.0.0.0:3001

# Both services mount the same persistent volume here.
ATTACHMENT_ROOT=/data/attachments

RUST_LOG=ladybird_reports=info,admin=info,public_api=info,migrate=info,tower_http=info
